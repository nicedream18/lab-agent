# Compose infrastructure settings. ./scripts/start-stack.sh generates random
# credentials in the ignored root .env without changing backend/.env.
MYSQL_DATABASE=lab_agent
MYSQL_USER=lab_agent
# Use a URL-safe password (the start script generates hexadecimal passwords).
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET_KEY=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
FRONTEND_PORT=8080
BACKEND_PORT=8001
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
LLM_CACHE_ENABLED=true
KB_WARMUP_ON_STARTUP=false

# Optional ELK profile: ./scripts/start-elk.sh generates these secrets as needed.
# Kibana login: elastic / ELASTIC_PASSWORD from the ignored root .env.
ELASTIC_VERSION=9.5.5
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
LOGSTASH_WRITER_PASSWORD=
KIBANA_SECURITY_ENCRYPTION_KEY=
KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=
KIBANA_REPORTING_ENCRYPTION_KEY=
