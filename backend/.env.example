# 复制为 backend/.env，并填入你自己的本地服务凭据；不要提交 .env。
DATABASE_URL=mysql+pymysql://lab_user:change-me@127.0.0.1:3306/lab_agent?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
LLM_API_KEY=replace-with-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=15
LLM_FIRST_TOKEN_TIMEOUT=10
LLM_FORCE_IPV4=false
LLM_CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
LLM_CACHE_TTL_SECONDS=60
LLM_CACHE_TIMEOUT=0.2
LLM_CACHE_NAMESPACE=lab-agent:llm:v1
# 可选链路追踪：填入 LangSmith Key 后开启；正文默认不上传。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lab-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_SAMPLING_RATE=1.0
# 多 workspace API Key 可按需指定：LANGSMITH_WORKSPACE_ID=
KB_WARMUP_ON_STARTUP=true
LAB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
KB_INFERENCE_DEVICE=cpu
KB_EMBEDDING_BATCH_SIZE=32
KB_RERANKER_ENABLED=true
KB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
KB_RERANKER_BATCH_SIZE=8
KB_RERANKER_MAX_LENGTH=512
KB_BATCH_WAIT_MS=3
KB_BATCH_MAX_PENDING=512
KB_INDEX_BATCH_SIZE=64
METRICS_ENABLED=true
METRICS_TOKEN=
LOG_LEVEL=INFO
LOG_SERVICE_NAME=lab-agent-backend
LOG_ENVIRONMENT=development
LOG_ACCESS_ENABLED=true
# Optional local file sink; Compose uses /app/logs/backend.jsonl for Logstash.
LOG_FILE=
