# 复制为 backend/.env，并填入你自己的本地服务凭据；不要提交 .env。
DATABASE_URL=mysql+pymysql://lab_user:change-me@127.0.0.1:3306/lab_agent?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
LLM_API_KEY=replace-with-your-provider-key
LLM_BASE_URL=https://your-openai-compatible-provider.example/v1
LLM_MODEL=your-model-name
LLM_TIMEOUT=15
LLM_FIRST_TOKEN_TIMEOUT=10
LLM_FORCE_IPV4=false
KB_WARMUP_ON_STARTUP=true
