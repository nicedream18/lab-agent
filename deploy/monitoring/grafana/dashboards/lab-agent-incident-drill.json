{
  "id": null,
  "uid": "lab-agent-incident-drill",
  "title": "Lab Agent · 故障演练",
  "description": "独立演练服务：正常、LLM 上游超时、恢复。正式后端指标不包含演练流量。",
  "tags": [
    "lab-agent",
    "incident-drill"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "实例",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "lab-agent-prometheus"
        },
        "definition": "label_values(up{job=\"lab-agent-drill\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"lab-agent-drill\"}, instance)",
          "refId": "instance"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "route",
        "label": "接口",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "lab-agent-prometheus"
        },
        "definition": "label_values(lab_agent_drill_http_requests_total{job=\"lab-agent-drill\",instance=~\"${instance}\",route=~\"/api/.*|__unmatched_api__\"}, route)",
        "query": {
          "query": "label_values(lab_agent_drill_http_requests_total{job=\"lab-agent-drill\",instance=~\"${instance}\",route=~\"/api/.*|__unmatched_api__\"}, route)",
          "refId": "route"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "/api/.*|__unmatched_api__",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
