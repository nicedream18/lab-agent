      "datasource": {
        "type": "prometheus",
        "uid": "lab-agent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
