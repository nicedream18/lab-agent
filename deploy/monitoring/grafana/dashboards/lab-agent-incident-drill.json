      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lab-agent-prometheus"
          },
          "expr": "sum(rate(lab_agent_drill_http_requests_total{job=\"lab-agent-drill\",instance=~\"${instance}\",route=~\"${route}\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
