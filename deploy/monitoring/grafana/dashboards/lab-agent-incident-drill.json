      "title": "P99 延迟",
      "description": "先合并所选接口的直方图桶，再计算 P99；包含成功与失败。",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-agent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
