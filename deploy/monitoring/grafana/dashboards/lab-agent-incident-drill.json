    {
      "id": 5,
      "title": "API 失败率",
      "description": "HTTP 错误、业务错误、Agent 显式失败、异常、取消占全部请求的比例。",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab-agent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "No data",
          "decimals": 2,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lab-agent-prometheus"
          },
          "expr": "100 * (sum(rate(lab_agent_drill_http_requests_total{job=\"lab-agent-drill\",instance=~\"${instance}\",route=~\"${route}\",outcome!=\"success\"}[$__rate_interval])) or (0 * sum(rate(lab_agent_drill_http_requests_total{job=\"lab-agent-drill\",instance=~\"${instance}\",route=~\"${route}\"}[$__rate_interval])))) / clamp_min(sum(rate(lab_agent_drill_http_requests_total{job=\"lab-agent-drill\",instance=~\"${instance}\",route=~\"${route}\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
